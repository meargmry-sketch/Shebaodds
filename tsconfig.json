{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "NodeNext"
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true
  },
  "include": ["*.ts", "src/**/*.ts", "routes/**/*.ts", "middleware/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}