/**
 * SHEBAODDS - Production Server Entry Point
 * Smart Bets. Real Wins.
 * 
 * This file runs the compiled JavaScript from the dist/ folder.
 * It does NOT depend on ts-node – it's pure Node.js.
 */

const fs = require('fs');
const path = require('path');

// ------------------------------------------------------------------
// 1. Check if the compiled entry file exists
// ------------------------------------------------------------------
const distPath = path.join(__dirname, 'dist', 'server.js');

if (!fs.existsSync(distPath)) {
  console.error('❌ Compiled server not found.');
  console.error('   Please run "npm run build" first.');
  process.exit(1);
}

// ------------------------------------------------------------------
// 2. Load environment variables (optional, but good practice)
// ------------------------------------------------------------------
try {
  require('dotenv').config();
} catch (_) {
  // dotenv may not be installed in production; it's fine if missing.
}

// ------------------------------------------------------------------
// 3. Start the compiled server
// ------------------------------------------------------------------
try {
  require('./dist/server.js');
} catch (err) {
  console.error('💥 Failed to start server:', err.message);
  console.error(err.stack);
  process.exit(1);
}